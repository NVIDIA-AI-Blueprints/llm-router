# Model Router Toolkit -- Environment Variables
#
# Copy to .env and fill in your values. The .env file is gitignored.

# Required for serving and data collection (pick one or both):
OPENROUTER_API_KEY=sk-or-...
NVIDIA_API_KEY=nvapi-...

# Optional: OpenAI-compatible provider
# OPENAI_API_KEY=sk-...

# Optional: Restrict CORS origins (comma-separated, default: *)
# CORS_ORIGINS=http://localhost:3000,https://myapp.example.com

# Optional: Webhook authentication for the router sidecar
# ROUTER_WEBHOOK_SECRET=my-shared-secret

# Optional: Override device auto-detection (cpu, cuda, mps)
# Useful for serve/serve-router/proxy modes which lack --device flags
# ROUTER_DEVICE=cpu

# Optional: Enable telemetry (disabled by default)
# ROUTER_TELEMETRY_DB=router_telemetry.db
